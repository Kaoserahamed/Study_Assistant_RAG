# API Configuration
# ============================================================
# Frontend Environment Configuration Template
# ============================================================
# Copy this file to .env for local development
# cp .env.example .env
#
# ⚠️ WARNING: Frontend .env values are bundled into client code
# NEVER put API keys or secrets here!
# ============================================================

# API Backend URL
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8000

# Optional: API Request Timeout (milliseconds)
# VITE_API_TIMEOUT=30000
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=Student Assistant
VITE_APP_VERSION=1.0.0
